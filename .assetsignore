# Keeps the deployed site to just what the app needs — the assets directory is the
# whole repo root, so without this, repo internals and docs would be servable too.
.git/
.gitignore
.assetsignore
wrangler.toml
README.md
database/
.claude/
tests/
# the Worker's own source — it runs, it is not served
worker/
# build scripts for the PDFs and the share card; they run here, never in a browser
tools/
# marketing renders are not part of the site
marketing/
